<!--
  1단계 장면: SO-101 + 바닥 + 블록(3 cm) + 목표 표시 + 위쪽 카메라(top).
  로봇 모델은 third_party의 Menagerie 파일을 include만 한다(수정 금지).
  단위: 길이 m, 각도 rad, 질량 kg.
-->
<mujoco model="handover_scene">
  <include file="../third_party/mujoco_menagerie/robotstudio_so101/so101.xml"/>
  <!-- include한 so101.xml의 meshdir="assets"는 이 파일(sim/) 기준으로 풀리므로 덮어쓴다. -->
  <compiler meshdir="../third_party/mujoco_menagerie/robotstudio_so101/assets"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" mark="edge" rgb1="0.75 0.75 0.75" rgb2="0.6 0.6 0.6"
      markrgb="0.4 0.4 0.4" width="300" height="300"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true" texrepeat="10 10" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor_mat"/>

    <!-- 집을 블록: 3 cm 정육면체(반변 0.015 m), 30 g, 자유롭게 움직임 -->
    <body name="block" pos="0.20 0 0.015">
      <freejoint name="block_free"/>
      <geom name="block" type="box" size="0.015 0.015 0.015" mass="0.03" rgba="0.85 0.15 0.15 1"
        friction="1.5 0.01 0.001" condim="4"/>
    </body>

    <!-- 목표 표시: 5 cm 사각형, 두께 1 mm, 충돌 없음(contype/conaffinity 0) -->
    <geom name="target" type="box" pos="0.20 0.12 0.0005" size="0.025 0.025 0.0005"
      contype="0" conaffinity="0" rgba="0.1 0.8 0.2 0.5"/>

    <!-- 위에서 내려다보는 카메라: 작업 공간 중심 위 0.7 m. 화면 위쪽 = 로봇 앞(+x), 화면 오른쪽 = -y -->
    <camera name="top" mode="fixed" pos="0.15 0.03 0.7" xyaxes="0 -1 0 1 0 0" fovy="50"/>
  </worldbody>

  <!-- home: 팔을 베이스 위로 세운 기본 자세(rad, 그리퍼 끝 약 x=0.03 m, z=0.35 m) + 블록 초기 위치.
       위 카메라에서 블록을 가리지 않는다. ctrl도 같게 해야 팔이 움직이지 않는다. -->
  <keyframe>
    <key name="home"
      qpos="0 -1.74 1.2 -1.2 0 0  0.20 0 0.015 1 0 0 0"
      ctrl="0 -1.74 1.2 -1.2 0 0"/>
  </keyframe>
</mujoco>
